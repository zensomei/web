---
import YAML from 'yaml';
import Layout from '../components/Layout.astro';
import Header from '../components/Header.astro';
import ProfileHero from '../components/ProfileHero.astro';
import PublicationCard from '../components/PublicationCard.astro';
import Section from '../components/Section.astro';
import Timeline from '../components/Timeline.astro';

import profileRaw from '../data/profile.yml?raw';
import publicationsRaw from '../data/publications.yml?raw';
import experiencesRaw from '../data/experiences.yml?raw';
import awardsRaw from '../data/awards.yml?raw';
import linksRaw from '../data/links.yml?raw';

type LinkItem = {
  label: string;
  url: string;
  type: 'internal' | 'external';
};

type Publication = {
  title: string;
  authors: string[];
  venue: string;
  year: number;
  status: string;
  image: string;
  description: string;
  links: { label: string; url?: string }[];
};

const profile = YAML.parse(profileRaw);
const { publications } = YAML.parse(publicationsRaw) as { publications: Publication[] };
const experiences = YAML.parse(experiencesRaw);
const { awards } = YAML.parse(awardsRaw);
const { links } = YAML.parse(linksRaw) as { links: LinkItem[] };

const updateModules = import.meta.glob('../content/updates/*.md', { eager: true });
const updates = Object.values(updateModules)
  .map((module) => {
    const frontmatter = (module as { frontmatter: { title: string; date: string | Date; summary: string } }).frontmatter;
    const date = typeof frontmatter.date === 'string'
      ? frontmatter.date.slice(0, 10)
      : new Date(frontmatter.date).toISOString().slice(0, 10);
    return { ...frontmatter, date };
  })
  .sort((a, b) => b.date.localeCompare(a.date));

const basePath = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const assetPath = (path: string) => `${basePath}${path.replace(/^\/+/, '')}`;
const linkPath = (link: LinkItem) => link.type === 'internal' ? assetPath(link.url) : link.url;

const navItems = [
  { label: 'Updates', href: '#updates' },
  { label: 'Work', href: '#work' },
  { label: 'Publications', href: '#publications' },
  { label: 'Backgrounds', href: '#backgrounds' },
  { label: 'Contact', href: '#contact' },
];
---

<Layout title={`${profile.name} (${profile.japaneseName})`}>
  <main class="page-shell">
    <Header name={profile.name} items={navItems} />

    <ProfileHero profile={profile} assetPath={assetPath} />

    <Section id="updates" title="Recent Updates" kicker="News">
      <div class="updates-list">
        {
          updates.map((update) => (
            <article class="update-item">
              <time datetime={update.date}>{update.date}</time>
              <div>
                <h3>{update.title}</h3>
                <p>{update.summary}</p>
              </div>
            </article>
          ))
        }
      </div>
    </Section>

    <Section id="work" title="Recent Work" kicker="Selected Demo">
      <article class="work">
        <div class="video-frame">
          <iframe
            src={profile.recentWork.video}
            title={profile.recentWork.title}
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen
            loading="lazy"
          ></iframe>
        </div>
        <div class="flow">
          <h3>{profile.recentWork.title}</h3>
          <p>
            {profile.recentWork.award},
            {' '}
            <a href={profile.recentWork.event.url} target="_blank" rel="noreferrer">
              {profile.recentWork.event.name}
            </a>
          </p>
          <p class="muted">{profile.recentWork.authors.join(', ')}</p>
        </div>
      </article>
    </Section>

    <Section id="publications" title="Main Publications" kicker="Research">
      <div class="publication-list">
        {
          publications.map((publication) => (
            <PublicationCard publication={publication} assetPath={assetPath} />
          ))
        }
      </div>
    </Section>

    <Section id="backgrounds" title="Main Backgrounds" kicker="Experience">
      <div class="background-grid">
        <Timeline title="Internships" items={experiences.internships} />
        <Timeline title="Fellowships" items={experiences.fellowships} />
        <Timeline title="Awards" items={awards} />
        <Timeline title="Education" items={experiences.education} />
      </div>
    </Section>

    <Section id="contact" title="Contact / Links" kicker="Connect">
      <div class="contact-panel">
        <p>{profile.email}</p>
        <div class="button-row">
          {
            links.map((link) => (
              <a
                class:list={['button-link', link.label === 'CV' && 'primary']}
                href={linkPath(link)}
                target={link.type === 'external' ? '_blank' : '_self'}
                rel={link.type === 'external' ? 'noreferrer' : undefined}
              >
                {link.label}
              </a>
            ))
          }
        </div>
      </div>
    </Section>

    <footer>
      <p>Copyright &copy; {new Date().getFullYear()} {profile.name}. All Rights Reserved.</p>
    </footer>
  </main>
</Layout>

<style>
  .updates-list,
  .publication-list,
  .background-grid {
    display: grid;
    gap: 1rem;
  }

  .update-item,
  .work,
  .contact-panel {
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 1rem;
    background: var(--surface);
    box-shadow: var(--shadow);
  }

  .update-item {
    display: grid;
    gap: 0.45rem;
  }

  time {
    color: var(--accent-strong);
    font-size: 0.9rem;
    font-weight: 800;
  }

  h3 {
    margin: 0;
    font-size: 1.18rem;
    line-height: 1.3;
  }

  p {
    margin: 0.3rem 0 0;
  }

  .work {
    display: grid;
    gap: 1rem;
  }

  .video-frame {
    position: relative;
    overflow: hidden;
    border-radius: 8px;
    background: #111;
    aspect-ratio: 16 / 9;
  }

  .video-frame iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .contact-panel p {
    color: var(--muted);
    overflow-wrap: anywhere;
  }

  footer {
    padding: 2.5rem 0 0;
    color: var(--muted);
    font-size: 0.92rem;
  }

  @media (min-width: 760px) {
    .update-item {
      grid-template-columns: 9.5rem 1fr;
    }

    .work {
      grid-template-columns: minmax(320px, 1fr) 0.85fr;
      align-items: center;
    }

    .background-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
