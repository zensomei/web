---
interface Profile {
  name: string;
  japaneseName: string;
  title: string;
  affiliation: {
    name: string;
    url: string;
  };
  fellowship: string;
  researchInterests: string[];
  email: string;
  cv: string;
  image: string;
}

interface Props {
  profile: Profile;
  assetPath: (path: string) => string;
}

const { profile, assetPath } = Astro.props;
---

<section class="hero" id="profile">
  <div class="portrait-wrap">
    <img class="portrait" src={assetPath(profile.image)} alt={`${profile.name} portrait`} />
  </div>
  <div class="hero-copy">
    <p class="eyebrow">Profile</p>
    <h1>{profile.name} <span>({profile.japaneseName})</span></h1>
    <p class="title">
      {profile.title} at{' '}
      <a href={profile.affiliation.url} target="_blank" rel="noreferrer">{profile.affiliation.name}</a>
    </p>
    <p class="muted">{profile.fellowship}</p>
    <div>
      <h2>Research Interests</h2>
      <ul class="chips" aria-label="Research interests">
        {profile.researchInterests.map((interest) => <li>{interest}</li>)}
      </ul>
    </div>
    <div class="button-row">
      <a class="button-link primary" href={assetPath(profile.cv)} target="_blank" rel="noreferrer">CV</a>
      <a class="button-link" href={`mailto:${profile.email.replace(' [at] ', '@')}`}>Email</a>
    </div>
  </div>
</section>

<style>
  .hero {
    display: grid;
    gap: 1.3rem;
    align-items: center;
    padding: 2rem 0 1rem;
  }

  .portrait-wrap {
    overflow: hidden;
    border-radius: 8px;
    background: var(--surface-muted);
    box-shadow: var(--shadow);
  }

  .portrait {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  .hero-copy {
    min-width: 0;
  }

  h1 {
    margin: 0;
    max-width: 780px;
    font-size: clamp(2rem, 7vw, 4.3rem);
    line-height: 1.05;
    letter-spacing: 0;
  }

  h1 span {
    display: block;
    color: var(--muted);
    font-size: 0.45em;
    font-weight: 700;
  }

  .title {
    margin: 1rem 0 0;
    font-size: 1.05rem;
  }

  h2 {
    margin: 1.35rem 0 0.6rem;
    font-size: 1rem;
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .chips li {
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 0.28rem 0.62rem;
    background: var(--surface);
    color: var(--muted);
    font-size: 0.9rem;
    font-weight: 650;
  }

  @media (min-width: 840px) {
    .hero {
      grid-template-columns: minmax(240px, 0.85fr) 1.25fr;
      gap: 2.4rem;
      padding: 3rem 0 1.8rem;
    }
  }
</style>
