---
interface Props {
  id: string;
  title: string;
  kicker?: string;
}

const { id, title, kicker } = Astro.props;
---

<section class="section" id={id}>
  <div class="section-head">
    {kicker && <p class="eyebrow">{kicker}</p>}
    <h2>{title}</h2>
  </div>
  <slot />
</section>

<style>
  .section {
    padding: 2.6rem 0 0;
  }

  .section-head {
    margin-bottom: 1.1rem;
  }

  h2 {
    margin: 0;
    font-size: clamp(1.65rem, 5vw, 2.45rem);
    line-height: 1.12;
    letter-spacing: 0;
  }
</style>
